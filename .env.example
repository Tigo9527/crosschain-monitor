# On the existing server, keep its current .env and database settings.
# Single-quote values containing $ so Compose preserves them literally.
DB_URL='mysql://monitor:replace-me@127.0.0.1:3306/crosschain'
E_SPACE_RPC=https://evm.confluxrpc.com
ETH_RPC=https://replace-with-your-ethereum-rpc
ARBITRUM_ONE_RPC=https://arb1.arbitrum.io/rpc
ETHER_SCAN_API_KEY=replace-with-your-etherscan-key
WEB_PORT=3003

# Existing alert tokens; empty values disable those notifications.
DING=
DEV_DING=
DING_CFX=

# Optional existing settings. Preserve their values when migrating.
# PROXY=http://127.0.0.1:7890
# FLOW_SCAN_KEY=
# CELER_ADDRESS=
# ZKSYNC_RPC=https://mainnet.era.zksync.io
# CELER_SOURCE_VAULTS='{"1":["0x7510792A3B1969F9307F3845CE88e39578f2bAE1"]}'
